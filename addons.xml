<?xml version='1.0' encoding='utf-8'?>
<addons>
    <addon id="context.otaku.rpdev" version="1.0.37" name="Otaku RPDev - Context Menu" provider-name="RPDevs">
        <requires>
            <import addon="xbmc.python" version="3.0.1" />
        </requires>
        <extension point="kodi.context.item">
            <menu id="kodi.core.main">
                <item library="default.py" args="findrecommendations">
                    <label>Find Recommendations</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.findrecommendations),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
                </item>
                <item library="default.py" args="findrelations">
                    <label>Find Relations</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.findrelations),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
                </item>
                <item library="default.py" args="getwatchorder">
                    <label>Get Watch Order</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.getwatchorder),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
                </item>
                <item library="default.py" args="viewreviews">
                    <label>View Reviews</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.viewreviews),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
                </item>
                <item library="default.py" args="viewstatistics">
                    <label>View Statistics</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.viewstatistics),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
                </item>
                <item library="default.py" args="markedaswatched">
                    <label>Marked as Watched [COLOR blue]WatchList[/COLOR]</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.markedaswatched),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + [String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,movie)] + !Player.HasMedia</visible>
                </item>
                <item library="default.py" args="markedasunwatched">
                    <label>Mark as Unwatched [COLOR blue]WatchList[/COLOR]</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.markedaswatched),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + [String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,movie)] + !Player.HasMedia</visible>
                </item>
                <item library="default.py" args="markpreviouswatched">
                    <label>Mark Episodes Up To Here as Watched</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.markpreviouswatched),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + String.IsEqual(ListItem.DBTYPE,episode) + !Player.HasMedia</visible>
                </item>
                <item library="default.py" args="rescrape">
                    <label>Rescrape</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.rescrape),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + [String.IsEqual(ListItem.DBTYPE,episode)|String.IsEqual(ListItem.DBTYPE,movie)] + !Player.HasMedia</visible>
                </item>
                <item library="default.py" args="sourceselect">
                    <label>Source Select</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.sourceselect),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + [String.IsEqual(ListItem.DBTYPE,episode)|String.IsEqual(ListItem.DBTYPE,movie)] + !Player.HasMedia</visible>
                </item>
                <item library="default.py" args="logout">
                    <label>Logout</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.logout),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + String.Contains(ListItem.folderpath,/watchlist/)</visible>
                </item>
                <item library="default.py" args="deletefromdatabase">
                    <label>Delete From Database</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.deletefromdatabase),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
                </item>
                <item library="default.py" args="watchlist">
                    <label>WatchList Manager</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.watchlist),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
                </item>
                <item library="default.py" args="fanartselect">
                    <label>Select Fanart</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.fanartselect),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/)+[String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
                </item>
                <item library="default.py" args="clearcache">
                    <label>Clear Addon Cache</label>
                    <visible>String.IsEqual(Window(home).Property(context.otaku.rpdev.clearcache),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.otaku.rpdev/)</visible>
                </item>
            </menu>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">Otaku - Global Context Menu Items</summary>
            <description lang="en">Adds Global Contextual Menu Items for otaku menu items throughout Kodi
    </description>
            <platform>all</platform>
            <license>GPL-3.0</license>
            <forum />
            <website />
            <source />
            <disclaimer lang="en" />
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
                <clearlogo>logo.png</clearlogo>
                <poster>poster.png</poster>
            </assets>
        </extension>
    </addon>
    <addon id="metadata.anime.otaku.python" name="Otaku Anime Scraper" version="1.2.2" provider-name="RPDevs">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
        </requires>
        <extension point="xbmc.metadata.scraper.tvshows" library="scraper.py">
            <provides>tvshows episodes</provides>
        </extension>
        <extension point="xbmc.metadata.scraper.movies" library="scraper_movies.py">
            <provides>movies</provides>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary>Anime Metadata Indexer powered by AniList and Otaku Mappings</summary>
            <description>A high-performance scraper mapping Eastern Anime databases to native Kodi formats with automated S01E01 filename standardization.</description>
            <license>GPL-3.0</license>
            <platform>all</platform>
        </extension>
    </addon>
    <addon id="plugin.video.otaku.rpdev" name="Otaku RPDev" provider-name="RPDevs" version="5.4.3">
        <requires>
            <import addon="xbmc.python" version="3.0.1" />
            <import addon="script.module.beautifulsoup4" />
            <import addon="script.module.inputstreamhelper" />
            <import addon="script.module.pyqrcode" />
            <import addon="context.otaku.rpdev" version="1.0.37" />
        </requires>
        <extension library="default.py" point="xbmc.python.pluginsource">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.service" library="service.py" />
        <extension point="xbmc.addon.metadata">
            <reuselanguageinvoker>false</reuselanguageinvoker>
            <summary lang="en">Otaku video plugin</summary>
            <description lang="en">Otaku is a provider based, streaming software that is tightly
            interwoven with Mal. Otaku provides the freedom to view media from a single menu system from service
            providers of the users choosing. Please Note: We do not host, create, or distribute any of the content displayed in the addon.
    </description>
            <platform>all</platform>
            <disclaimer>Otaku is and always will be free and open-source. None of its code and resources may be sold or redistributed for any commercial purposes.[CR]This addon and its developers [B]DO NOT[/B] host, create, or distribute any of the content displayed in the addon, it simply scrapes ad financed public websites. It is the responsibility of the user to ensure that they are following all applicable laws and regulations in their country.[CR]This addon and its developers are not in any way affiliated with Team Kodi or any of the sites and providers used in the addon.</disclaimer>
            <license>GPL-3.0</license>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
                <clearlogo>logo.png</clearlogo>
                <poster>poster.png</poster>
                <screenshot>resources/screenshots/screenshot-01.jpg</screenshot>
                <screenshot>resources/screenshots/screenshot-02.jpg</screenshot>
                <screenshot>resources/screenshots/screenshot-03.jpg</screenshot>
                <screenshot>resources/screenshots/screenshot-04.jpg</screenshot>
            </assets>
        </extension>
    </addon>
    <addon id="repository.rpdevs" name="RPDevs Add-on Repository" version="1.0.1" provider-name="RPDev">
        <extension point="xbmc.addon.repository" name="RPDevs Add-on Repository">
            <dir>
                <info compressed="false">https://kodi.repo.iamrp.dev/addons.xml</info>
                <checksum>https://kodi.repo.iamrp.dev/addons.xml.md5</checksum>
                <datadir zip="true">https://kodi.repo.iamrp.dev/</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary>Official RPDevs Add-on Repository</summary>
            <description>Official repository for RPDevs first-party streaming resolvers, anime scrapers, and playback utilities for Kodi v21 (Omega) and v22 (Piers).</description>
            <disclaimer>Official release channel for RPDev first-party software.</disclaimer>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
    <addon id="script.service.flaresolverr" name="FlareSolverr Service" provider-name="RPDev" version="1.0.0">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
        </requires>
        <extension point="xbmc.service" library="service.py" />
        <extension point="xbmc.addon.metadata">
            <platform>all</platform>
            <license>MIT</license>
            <summary lang="en_GB">Local FlareSolverr service for Kodi.</summary>
            <description lang="en_GB">Runs a headless local FlareSolverr proxy to solve Cloudflare Turnstile and anti-bot challenges natively inside Kodi.</description>
            <assets>
                <icon>icon.png</icon>
            </assets>
        </extension>
    </addon>
    <addon id="script.service.megacloud" name="Megacloud Solver" provider-name="RPDev" version="1.0.0">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
        </requires>
        <extension point="xbmc.service" library="service.py" />
        <extension point="xbmc.python.script" library="default.py">
            <provides>executable</provides>
        </extension>
        <extension point="xbmc.python.module" library="resources/lib/" />
        <extension point="xbmc.addon.metadata">
            <platform>all</platform>
            <license>GPL-2.0-or-later</license>
            <summary lang="en_GB">Standalone local Megacloud decrypter and resolver HTTP server.</summary>
            <description lang="en_GB">Exposes an HTTP server on port 4000 to resolve Megacloud/Vidcloud embed URLs natively inside Kodi. Other add-ons can configure their solver URL to use this local service.</description>
            <assets>
                <icon>icon.png</icon>
            </assets>
        </extension>
    </addon>
</addons>